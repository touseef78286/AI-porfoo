{
  "name": "local-project-intelligence",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first project discovery, intelligence, and portfolio publishing for Windows.",
  "type": "module",
  "engines": {
    "node": ">=18",
    "npm": ">=8"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --maxWorkers=2",
    "verify": "npm run typecheck && npm test && npm run verify:phase0",
    "verify:phase0": "node scripts/verify-phase0.mjs",
    "dev": "tsx apps/agent/src/api/index.ts",
    "scan": "tsx apps/agent/src/cli/scan.ts",
    "watch": "tsx apps/agent/src/cli/watch.ts",
    "build": "tsc --build --dry-run && echo 'Build configuration valid'"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "dist/index.mjs",
      "require": "dist/index.js",
      "types": "dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local-project-intelligence/local-project-intelligence.git"
  },
  "license": "MIT",
  "dependencies": {
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}